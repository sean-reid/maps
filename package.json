{
  "name": "maps",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A world map where each country's area is the quantity being shown.",
  "scripts": {
    "dev": "wrangler dev",
    "dev:web": "vite",
    "wasm": "cargo build --release --target wasm32-unknown-unknown -p cartogram && cp target/wasm32-unknown-unknown/release/cartogram.wasm src/solver/cartogram.wasm",
    "build": "npm run wasm && vite build",
    "pretest": "npm run wasm",
    "typecheck": "tsc --noEmit && tsc -p worker/tsconfig.json",
    "lint": "eslint src worker scripts tools tests vite.config.ts playwright.config.ts eslint.config.js prettier.config.js --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "size": "node scripts/size.ts",
    "geometry": "node tools/geometry/build.ts",
    "seed": "node scripts/seed-local.ts",
    "test:e2e": "playwright test",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260928.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "eslint": "^10.11.0",
    "mapshaper": "^0.8.5",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "wrangler": "^4.143.0"
  }
}
